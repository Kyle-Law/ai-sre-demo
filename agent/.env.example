# AI SRE agent configuration. On the agent VM this lives at
# /etc/ai-sre-agent/agent.env (mode 0600, owner aisre). Never commit it.

# --- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=30

# --- Kubernetes (read-only kubeconfig from scripts/generate-agent-kubeconfig.sh)
KUBECONFIG=/etc/ai-sre-agent/kubeconfig
KUBECTL_BIN=/usr/local/bin/kubectl
ARGOCD_NAMESPACE=argocd

# --- Grafana (Viewer service-account token from scripts/create-grafana-token.sh)
GRAFANA_URL=http://CLUSTER_VM_IP:30300
GRAFANA_TOKEN=glsa_...
GRAFANA_PROM_UID=prometheus

# --- Jira Cloud (bot account API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=ai-sre-bot@example.com
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=INC
JIRA_TRIAGE_LABEL=ai-triage
# Workflow transition (or target status) names; missing ones are skipped.
JIRA_TRANSITION_START="In Progress"
JIRA_TRANSITION_REVIEW="In Review"
JIRA_TRANSITION_DONE=Done

# --- GitHub (bot user fine-grained PAT: Contents RW + Pull requests RW on ONE repo)
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-org/ai-sre-demo
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
# Comma-separated GitHub usernames to request review from
GITHUB_REVIEWERS=
# Files the agent may change (CI enforces the same rule)
AGENT_ALLOWED_PATHS=apps/

# --- Loop timing ----------------------------------------------------------
POLL_SECONDS=20
VERIFY_STABLE_SECONDS=90
VERIFY_TIMEOUT_SECONDS=900
SYNC_TIMEOUT_SECONDS=600
MAX_ATTEMPTS=2

# --- Storage --------------------------------------------------------------
STATE_DB=/var/lib/ai-sre-agent/state.db
AUDIT_LOG=/var/log/ai-sre-agent/audit.jsonl

# true = investigate and print Jira comments / PRs instead of writing them
DRY_RUN=false
