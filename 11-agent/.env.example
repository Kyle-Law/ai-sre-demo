# AI SRE agent configuration: cp 11-agent/.env.example agent.env (repo root,
# git-ignored, chmod 600) and run make step-11. Never commit it.

# --- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5: stronger reasoning. claude-haiku-5-5: ~20x cheaper per token, fine for the demo
# scenarios. Compare with the model_usage events in the audit log.
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=30

# --- Kubernetes (read-only kubeconfig from step 09)
KUBECONFIG=agent.kubeconfig
KUBECTL_BIN=kubectl
ARGOCD_NAMESPACE=argocd

# --- Grafana (Viewer token from 09-agent-access/create-grafana-token.sh)
GRAFANA_URL=http://localhost:30300
GRAFANA_TOKEN=glsa_...
GRAFANA_PROM_UID=prometheus

# --- Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-site.atlassian.net
# Service account (any name): leave JIRA_EMAIL empty, put its scoped token in JIRA_API_TOKEN and
# set JIRA_API_URL=https://api.atlassian.com/ex/jira/<cloudId>  (see demo.env.example)
JIRA_EMAIL=ai-sre-bot@example.com
JIRA_API_URL=
# Name of the agent's Jira service account (your choice, e.g. ai-sre-agent). When set, selftest
# fails if the token belongs to anyone else. Empty: it only reports who the token is.
JIRA_AGENT_SA_NAME=
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=INC
JIRA_TRIAGE_LABEL=ai-triage
# Status to move the ticket to on pickup / PR opened / verified (transition or status names).
# Empty = don't move. Use a path when there's no direct transition, e.g. "Work in progress > Done".
# Unavailable steps are skipped and logged (jira_transition_unavailable lists what was possible).
# Software project:     "In Progress" / "In Review" / Done
# Service-desk Task:    "Work in progress > Pending" / (empty) / "Work in progress > Done"
JIRA_TRANSITION_START="In Progress"
JIRA_TRANSITION_REVIEW="In Review"
JIRA_TRANSITION_DONE=Done

# --- GitHub: the agent's GitHub App (step 10 prints these)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=github-app.pem
# Optional; looked up from GITHUB_REPO when empty
GITHUB_APP_INSTALLATION_ID=
# Alternative to the App: a bot user's token (leave GITHUB_APP_ID empty)
GITHUB_TOKEN=
GITHUB_REPO=your-org/ai-sre-demo
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
# Comma-separated GitHub usernames to request review from
GITHUB_REVIEWERS=
# Files the agent may change (CI enforces the same rule)
AGENT_ALLOWED_PATHS=06-demo-app/manifests/

# --- Loop timing ----------------------------------------------------------
POLL_SECONDS=20
VERIFY_STABLE_SECONDS=90
VERIFY_TIMEOUT_SECONDS=900
SYNC_TIMEOUT_SECONDS=600
MAX_ATTEMPTS=2

# --- Storage --------------------------------------------------------------
STATE_DB=.agent/state.db
AUDIT_LOG=.agent/audit.jsonl

# true = investigate and print Jira comments / PRs instead of writing them
DRY_RUN=false
