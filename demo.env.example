# Copy to demo.env (git-ignored) and fill in. Read by every step script via lib/common.sh.

# --- Local kind cluster ---------------------------------------------------
KIND_CLUSTER_NAME=ai-sre
GRAFANA_URL=http://localhost:30300   # Grafana NodePort, mapped to localhost by 01-kind-cluster/cluster.yaml

# --- Git repo ArgoCD deploys from ------------------------------------------
GITHUB_REPO=your-org/ai-sre-demo # owner/name
GITHUB_HUMAN_REVIEWER=your-github-username
# The agent's GitHub App bot login, printed by step 10 (make step-10)
GITHUB_AGENT_LOGIN=your-app-slug[bot]
# Only for a PRIVATE repo: read-only token ArgoCD uses to pull (leave empty for public)
ARGOCD_REPO_READ_TOKEN=

# --- Versions ---------------------------------------------------------------
ARGOCD_VERSION=v3.4.11

# --- Grafana admin (stored in a K8s Secret, never in git) ------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# --- Jira (used by the in-cluster alert bridge to CREATE tickets) ----------
JIRA_BASE_URL=https://your-site.atlassian.net
# Either a user's classic API token (JIRA_EMAIL + JIRA_API_TOKEN), or a Jira service account
# (any name you like): its scoped token in JIRA_API_TOKEN, JIRA_EMAIL empty, and the API gateway:
#   JIRA_API_URL=https://api.atlassian.com/ex/jira/<cloudId>
#   cloudId: curl -s https://your-site.atlassian.net/_edge/tenant_info
JIRA_EMAIL=alerts-bot@example.com
JIRA_API_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INC
